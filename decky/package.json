{
  "name": "outbreak-tracker",
  "version": "0.2.4",
  "description": "Live Outbreak tracker and local-network phone view for Steam Deck",
  "author": "solitonmedic",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "qrcode-generator": "1.4.4",
    "react-icons": "5.3.0",
    "tslib": "2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
